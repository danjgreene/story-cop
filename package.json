{
  "name": "story-cop",
  "version": "0.1.0",
  "private": true,
  "description": "Concept-to-screenplay development tool with a Claude story editor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "goldens": "node scripts/make-goldens.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.10",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0"
  }
}
